import "std:list"
import "std:dynamic"

import "intrinsic" as intrinsic

is nat -> nat -> nat
xor x y = intrinsic.nat-xor (x, y)

is 'a -> nat
hash x = hash-dynamic (dynamic x)

local hash-dynamic x =
  match x
    :lambda -> intrinsic.int-hash 0
    :action -> intrinsic.int-hash 1

    :str' x -> intrinsic.str-hash x
    :nat' x -> intrinsic.nat-hash x
    :int' x -> intrinsic.int-hash x
    :real' x -> intrinsic.real-hash x

    :list xs -> xs
      |> map hash-dynamic
      |> fold 0 xor

    :tuple xs -> xs
      |> map hash-dynamic
      |> fold 0 xor

    :record xs -> xs
      |> map \_, x. hash-dynamic x
      |> fold 0 xor

    :variant (n, x) -> match x
      :some x -> xor (intrinsic.str-hash n) (hash-dynamic x)
      :none -> intrinsic.str-hash n
