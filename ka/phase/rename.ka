import "std:string" as string
import "std:map"    as map
import "std:set"    as set
import "std:list"   as list
import "std:debug"  as debug
import "std:option" as option

import "ka:diagnostic/diagnostic" as diagnostic
import "ka:diagnostic/span"       as span
import "ka:ast"                   as ast

type renamed = {
  aliases: [alias]
  globals: map unique global

  dependencies: map unique (set unique)
}

type unique = nat

type name = {
  unique: unique
  label:  str
  kind:   kind
  span:   option span
}

type alias = {
  name:   name
  params: [name]
  ty:     ty name 
  span:   span
}

type global = {
  unique: unique
  ty:     option (ty name)
  pat:    pat name {}
  params: [pat name {}]
  output: expr name {}
  span:   span
}

type intrinsic =
  | :dynamic
  | :trace
  | :panic

  | :nat-format
  | :nat-hash
  | :nat-xor

  | :int-format
  | :int-hash

  | :real-format
  | :real-hash

  | :str-hash
  | :str-length
  | :str-prepend
  | :str-split-at
  | :str-find

type kind =
  | :type'
  | :local'
  | :import'
  | :generic
  | :intrinsic intrinsic
  | :global unique

is [str, [module-def]] -> renamed, [diagnostic]
rename modules =
  let state = {
    aliases: []
    globals: map.empty
    imports: map.empty
    modules: map.empty

    dependencies: map.empty

    next-unique: 0
    diagnostics: []
  }

  let state = add-intrinsic state

  let state, modules = modules
    |> list.fold (state, []) \state, modules name, defs.
      let state, unique = add-import name state
      state, (unique, defs) :: modules

  let state, modules = modules
    |> list.fold (state, []) \state, modules unique, defs.
      let env = {
        this:      unique
        imports:   []
        types:     map.empty
        variables: map.empty
      }

      let env = prelude
        |> list.fold env \env path, name.
          let module = map.get path state.imports
            |> assert-some "std modules should exist"

          let name = {
            unique: module
            label:  name
            kind:   :import'
            span:   :none
          }

          env with {
            imports: module :: env.imports
            types: map.insert name.label name env.types
            variables: map.insert name.label name env.variables
          }

      let env, state = defs
        |> list.fold (env, state) \env, state def.
          match def
            :import' def -> partial-import env state def
            _ -> env, state

      let env, state, globals, types = defs
        |> list.fold (env, state, [], []) partial-def

      let module = map.list env.types
        |> list.fold env \env label, name.
          match name.kind
            :import' ->
              env with {
                types: map.remove label env.types
              }
            _ -> env

      let module = map.list env.variables
        |> list.fold module \env label, name.
          match name.kind
            :import' ->
              env with {
                variables: map.remove label env.variables
              }
            _ -> env

      let state = state with {
        modules: map.insert unique module state.modules
      }

      state, (unique, env, globals, types) :: modules

  let state = modules
    |> list.fold state \state unique, env, globals, types.
      let state = types
        |> list.fold state (rename-type env)

      let state = globals
        |> list.fold state (rename-global env)

      state

  let renamed = {
    aliases: state.aliases
    globals: state.globals
    dependencies: state.dependencies
  }

  renamed, state.diagnostics

local type env = {
  this:      unique
  imports:   [unique]
  types:     map str name
  variables: map str name
}

local type state = {
  aliases: [alias]
  globals: map unique global
  imports: map str unique
  modules: map unique env

  dependencies: map unique (set unique)

  next-unique: nat
  diagnostics: [diagnostic]
}

is state -> state
local add-intrinsic state =
  let state, variables = intrinsics
    |> list.fold (state, map.empty) \state, variables name, intrinsic.
      let state, unique = add-unique state

      let name = {
        unique: unique
        label:  name
        kind:   :intrinsic intrinsic
        span:   :none
      }

      state, map.insert name.label name variables

  let env = {
    this:      0
    imports:   []
    types:     map.empty
    variables: variables
  }

  let state, unique = add-unique state

  state with {
    imports: map.insert "intrinsic" unique state.imports
    modules: map.insert unique env state.modules
  }

local prelude = [
  "std:bool", "bool"
  "std:list", "list"
  "std:option", "option"
  "std:hash", "hash"
]

local intrinsics = [
  "dynamic", :dynamic
  "trace",   :trace
  "panic",   :panic

  "nat-format", :nat-format
  "nat-hash",   :nat-hash
  "nat-xor",    :nat-xor

  "int-format", :int-format
  "int-hash",   :int-hash

  "real-format", :real-format
  "real-hash",   :real-hash

  "str-hash",     :str-hash
  "str-length",   :str-length
  "str-prepend",  :str-prepend
  "str-split-at", :str-split-at
  "str-find",     :str-find
]

local add-unique state =
  let unique = state.next-unique

  let state = state with {
    next-unique: state.next-unique + 1
  }

  state, unique

local add-import name state =
  let state, unique = add-unique state

  let state = state with {
    imports: state.imports
      |> map.insert name unique
  }

  state, unique

local add-diagnostic state diagnostic =
  state with {
    diagnostics: diagnostic :: state.diagnostics
  }

local partial-def env, state, gs, ts def =
  match def
    :import' def -> env, state, gs, ts

    :type' def ->
      let env, state, type' = partial-type env state def
      env, state, gs, type' :: ts

    :global def ->
      let env, state, global = partial-global env state def
      env, state, global :: gs, ts

    :error _ ->
      env, state, gs, ts

local partial-import env state def =
  match map.get def.path state.imports
    :some unique ->
      let env = env with {
        imports: unique :: env.imports
      }

      let env = match def.name
        :none -> env
        :some label ->
          let name = {
            unique: unique
            label:  label
            kind:   :import'
            span:   :some def.span
          }

          env with {
            types:     map.insert label name env.types
            variables: map.insert label name env.variables
          }

      env, state

    :none ->
      let state = "invalid import path `"
        |> string.append def.path
        |> string.append "`"
        |> error
        |> label def.span "in import found here"
        |> add-diagnostic state

      env, state

local partial-type env state def =
  let state, unique = add-unique state

  let name = {
    unique: unique
    label:  def.name
    kind:   :type'
    span:   :some def.span
  }

  let state, params = def.params
    |> list.fold (state, []) \state, params param.
      let state, unique = add-unique state
      let name = string.prepend "'" param

      let name = {
        unique: unique
        label:  name
        kind:   :generic
        span:   :none
      }

      state, list.append [name] params

  let env = env with {
    types: map.insert def.name name env.types
  }

  let alias = {
    unique: unique
    name:   name
    params: params
    ty:     def.ty
    span:   def.span
  }

  env, state, alias

local partial-global env state def =
  let state, unique = add-unique state
  let kind = :global unique
  let env, state, pat = rename-pat env state def.pat kind

  let global = {
    unique:   unique
    is-local: def.is-local
    ty:       def.ty
    pat:      pat
    params:   def.params
    output:   def.output
    span:     def.span
  }

  env, state, global

local rename-type env state partial =
  let env = partial.params
    |> list.fold env \env param.
      env with {
        types: map.insert param.label param env.types
      }

  let _env, state, ty = rename-ty env state partial.ty

  let alias = {
    name:   partial.name
    params: partial.params
    ty:     ty
    span:   partial.span
  }

  state with {
    aliases: alias :: state.aliases
  }

local rename-global env state partial =
  let env, state, ty = rename-option-ty env state partial.ty

  let env, state, params = rename-pats env state partial.params :local'

  let env = env with { this: partial.unique }
  let state, output = rename-expr env state partial.output

  let global = {
    unique: partial.unique
    ty:     ty
    pat:    partial.pat
    params: params
    output: output
    span:   partial.span
  }

  state with {
    globals: map.insert global.unique global state.globals
  }

is env -> state -> [pat str {}] -> kind -> env, state, [pat name {}]
local rename-pats env state pats kind =
  pats |> list.fold (env, state, []) \env, state, pats pat.
    let env, state, pat = rename-pat env state pat kind
    env, state, list.append [pat] pats

is env -> state -> pat str {} -> kind -> env, state, pat name {}
local rename-pat env state pat kind =
  match pat
    :bind pat ->
      let state = match kind
        :global _ -> match map.get pat.name env.variables
          :none -> state
          :some name -> match name.kind
            :import' -> state
            _ ->
              "duplicate variable `"
                |> string.append pat.name
                |> string.append "`"
                |> error
                |> label pat.span "found here"
                |> add-diagnostic state
        _ -> state

      let state, unique = add-unique state

      let name = {
        unique: unique
        label:  pat.name
        kind:   kind
        span:   :some pat.span
      }

      let env = env with {
        variables: map.insert pat.name name env.variables
      }

      let pat = :bind {
        name: name
        span: pat.span
        ty:   {}
      }

      env, state, pat

    :wild pat ->
      env, state, :wild {
        span: pat.span
      }

    :empty pat ->
      env, state, :empty {
        span: pat.span
      }

    :str' pat ->
      env, state, :str' {
        value: pat.value
        span:  pat.span
      }

    :paren pat ->
      let env, state, inner = rename-pat env state pat.pat kind

      env, state, :paren {
        pat:  inner
        span: pat.span
      }

    :cons pat ->
      let env, state, first = rename-pat env state pat.first kind
      let env, state, rest = rename-pat env state pat.rest kind

      env, state, :cons {
        first: first
        rest:  rest
        span:  pat.span
      }

    :tuple pat ->
      let env, state, fields = rename-pats env state pat.fields kind

      env, state, :tuple {
        fields: fields
        span:   pat.span
      }

    :variant pat ->
      let env, state, payload = match pat.payload
        :some payload ->
          let env, state, payload = rename-pat env state payload kind
          env, state, :some payload
        :none -> env, state, :none

      env, state, :variant {
        name:    pat.name
        payload: payload
        span:    pat.span
      }

    :error span -> env, state, :error span

local rename-tys env state tys =
  tys |> list.fold (env, state, []) \env, state, tys ty.
    let env, state, ty = rename-ty env state ty
    env, state, list.append [ty] tys

local rename-option-ty env state ty =
  match ty
    :some ty ->
      let env, state, ty = rename-ty env state ty
      env, state, :some ty
    :none -> env, state, :none

is env -> state -> ty str -> env, state, ty name
local rename-ty env state ty =
  match ty
    :var ty ->
      match find-ty env state ty.name
        :some name -> match name.kind
          :import' ->
            let state = "module without field"
              |> error
              |> label ty.span "module must be indexed by a field"
              |> add-diagnostic state

            env, state, :error ty.span

          _ ->
            env, state, :var {
              name: name
              span: ty.span
            }

        :none ->
          let state = "type `"
            |> string.append ty.name
            |> string.append "` not defined"
            |> error
            |> label ty.span "found here"
            |> add-diagnostic state

          env, state, :error ty.span

    :str' ty -> env, state, :str' { span: ty.span }
    :nat' ty -> env, state, :nat' { span: ty.span }
    :int' ty -> env, state, :int' { span: ty.span }
    :real' ty -> env, state, :real' { span: ty.span }

    :paren ty ->
      let env, state, inner = rename-ty env state ty.ty

      env, state, :paren {
        ty:   inner
        span: ty.span
      }

    :list ty ->
      let env, state, item = rename-ty env state ty.item

      env, state, :list {
        item: item
        span: ty.span
      }

    :lambda ty ->
      let env, state, input = rename-ty env state ty.input
      let env, state, output = rename-ty env state ty.output

      env, state, :lambda {
        input:  input
        output: output
        span:   ty.span
      }

    :generic ty ->
      let name = string.prepend "'" ty.name

      let env, state, name = match map.get name env.types
        :some name -> env, state, name
        :none ->
          let state, unique = add-unique state

          let name = {
            unique: unique
            label:  name
            kind:   :generic
            span:   :some ty.span
          }

          let env = env with {
            types: map.insert name.label name env.types
          }

          env, state, name

      env, state, :generic {
        name: name
        span: ty.span
      }

    :record ty ->
      let env, state, fields = rename-ty-fields env state ty.fields

      env, state, :record {
        fields: fields
        span:   ty.span
      }

    :tuple ty ->
      let env, state, fields = rename-tys env state ty.fields

      env, state, :tuple {
        fields: fields
        span:   ty.span
      }

    :union ty ->
      let env, state, variants = ty.variants
        |> list.fold (env, state, []) \env, state, variants variant.
          let env, state, variant = rename-ty-variant env state variant
          env, state, list.append [variant] variants

      env, state, :union {
        variants: variants
        span:     ty.span
      }

    :apply ty ->
      let env, state, lambda = rename-ty env state ty.lambda
      let env, state, input = rename-ty env state ty.input

      env, state, :apply {
        lambda: lambda
        input:  input
        span:   ty.span
      }

    :field ty ->
      match get-ty-module env state ty.input
        :some (module, name) -> match map.get ty.name module.types
          :some name ->
            env, state, :var {
              name: name
              span: ty.span
            }

          :none ->
            let state = "module `"
              |> string.append name.label
              |> string.append "` does not have type `"
              |> string.append ty.name
              |> string.append "`"
              |> error
              |> label ty.span "here"
              |> add-diagnostic state

            env, state, :error ty.span

        :none ->
          let env, state, input = rename-ty env state ty.input

          env, state, :field {
            input: input
            name:  ty.name
            span:  ty.span
          }

    :action ty ->
      let env, state, output = rename-ty env state ty.output

      env, state, :action {
        output: output
        span:   ty.span
      }

    :error span -> env, state, :error span

local get-ty-module env state ty = match ty
  :var ty -> match map.get ty.name env.types
    :some name -> match name.kind
      :import' ->
        map.get name.unique state.modules
          |> map-some \env. env, name
      _ -> :none
    :none -> :none
  _ -> :none

is env -> state -> str -> option name
local find-ty env state name =
  match map.get name env.types
    :some name -> match name.kind
      :import' ->
        find-imported-ty env state name.label
          |> some-else (:some name)

      _ -> :some name

    :none -> env.imports
      |> find-map \unique.
        map.get unique state.modules
          |> try-map-some \env.
            map.get name env.types

local find-imported-ty env state name =
  env.imports |> find-map \unique.
    map.get unique state.modules
      |> try-map-some \env. map.get name env.types

local rename-ty-fields env state fields =
  fields |> list.fold (env, state, []) \env, state, fields field.
    let env, state, field = rename-ty-field env state field
    env, state, list.append [field] fields

local rename-ty-field env state field =
  let env, state, ty = rename-ty env state field.ty

  env, state, {
    name: field.name
    ty:   ty
    span: field.span
  }

local rename-ty-variant env state variant =
  let env, state, payload = rename-option-ty env state variant.payload

  env, state, {
    name:    variant.name
    payload: payload
    span:    variant.span
  }

local rename-exprs env state exprs =
  exprs |> list.fold (state, []) \state, exprs expr.
    let state, expr = rename-expr env state expr
    state, list.append [expr] exprs

is env -> state -> expr str {} -> state, expr name {}
local rename-expr env state expr =
  match expr
    :var expr ->
      match find-variable env state expr.name
        :some name ->
          let var = :var {
            name: name
            span: expr.span
            ty:   {}
          }

          match name.kind
            :global unique ->
              let dependencies = map.get env.this state.dependencies
                |> some-or set.empty
                |> set.insert unique

              let state = state with {
                dependencies: map.insert env.this dependencies state.dependencies
              }

              state, var

            :import' ->
              let state = "module without field"
                |> error
                |> label expr.span "module must be indexed by a field"
                |> add-diagnostic state

              state, :error expr.span

            _ -> state, var

        :none ->
          let state = "variable `"
            |> string.append expr.name
            |> string.append "` not defined"
            |> error
            |> label expr.span "found here"
            |> add-diagnostic state

          state, :error expr.span

    :nat' expr ->
      state, :nat' {
        value: expr.value
        span:  expr.span
        ty:    {}
      }

    :str' expr ->
      state, :str' {
        value: expr.value
        span:  expr.span
      }

    :paren expr ->
      let state, inner = rename-expr env state expr.expr

      state, :paren {
        expr: inner
        span: expr.span
      }

    :field expr ->
      match get-var-module env state expr.input
        :some (module, name) -> match map.get expr.name module.variables
          :some name ->
            let state = match name.kind
              :global unique ->
                let dependencies = map.get env.this state.dependencies
                  |> some-or set.empty
                  |> set.insert unique

                state with {
                  dependencies: map.insert env.this dependencies state.dependencies
                }

              _ -> state

            state, :var {
              name: name
              span: expr.span
              ty:   {}
            }

          :none ->
            let state = "module `"
              |> string.append name.label
              |> string.append "` does not have variable `"
              |> string.append expr.name
              |> string.append "`"
              |> error
              |> label expr.span "here"
              |> add-diagnostic state

            state, :error expr.span

        :none ->
          let state, input = rename-expr env state expr.input

          state, :field {
            input: input
            name:  expr.name
            span:  expr.span

            name-span: expr.name-span
          }

    :with' expr ->
      let state, input = rename-expr env state expr.input
      let state, fields = rename-expr-fields env state expr.fields

      state, :with' {
        input:  input
        fields: fields
        span:   expr.span
        ty:     {}
      }

    :apply expr ->
      let state, lambda = rename-expr env state expr.lambda
      let state, input  = rename-expr env state expr.input

      state, :apply {
        lambda: lambda
        input:  input
        span:   expr.span
      }

    :pipe expr ->
      let state, input  = rename-expr env state expr.input
      let state, lambda = rename-expr env state expr.lambda

      state, :pipe {
        input:  input
        lambda: lambda
        span:   expr.span
      }

    :lambda expr ->
      let env, state, params = rename-pats env state expr.params :local'
      let state, output = rename-expr env state expr.output

      state, :lambda {
        params: params
        output: output
        span:   expr.span
      }

    :list expr ->
      let state, items = rename-exprs env state expr.items

      state, :list {
        items: items
        span:  expr.span
      }

    :variant expr ->
      let state, payload = match expr.payload
        :some payload ->
          let state, payload = rename-expr env state payload
          state, :some payload
        :none -> state, :none

      state, :variant {
        name:    expr.name
        payload: payload
        span:    expr.span
      }

    :record expr ->
      let state, fields = rename-expr-fields env state expr.fields

      state, :record {
        fields: fields
        span:   expr.span
      }

    :tuple expr ->
      let state, fields = rename-exprs env state expr.fields

      state, :tuple {
        fields: fields
        span:   expr.span
      }

    :unary expr ->
      let state, input = rename-expr env state expr.input

      state, :unary {
        op:      expr.op
        op-span: expr.op-span
        input:   input
        span:    expr.span
      }

    :binary expr ->
      let state, lhs = rename-expr env state expr.lhs
      let state, rhs = rename-expr env state expr.rhs

      state, :binary {
        lhs:     lhs
        op:      expr.op
        op-span: expr.op-span
        rhs:     rhs
        span:    expr.span
        ty:      {}
      }

    :block expr ->
      let env, state, stmts = expr.stmts
        |> list.fold (env, state, []) \env, state, stmts stmt.
          let env, state, stmt = rename-let env state stmt
          env, state, list.append[stmt] stmts

      let state, output = rename-expr env state expr.output

      state, :block {
        stmts:  stmts
        output: output
        span:   expr.span
      }

    :do' expr ->
      let state, inner = rename-expr env state expr.expr

      state, :do' {
        expr: inner
        span: expr.span
      }

    :do-block expr ->
      let env, state, stmts = expr.stmts
        |> list.fold (env, state, []) \env, state, stmts stmt.
          match stmt
            :let' stmt ->
              let env, state, stmt = rename-let env state stmt
              env, state, list.append [:let' stmt] stmts

            :bind stmt ->
              let env, state, stmt = rename-let env state stmt
              env, state, list.append [:bind stmt] stmts

            :expr expr ->
              let state, expr = rename-expr env state expr
              env, state, list.append [:expr expr] stmts

      state, :do-block {
        stmts: stmts
        span:  expr.span
      }

    :match' expr ->
      let state, input = rename-expr env state expr.input

      let state, arms = expr.arms
        |> list.fold (state, []) \state, arms arm.
          let env, state, pat = rename-pat env state arm.pat :local'
          let state, expr = rename-expr env state arm.expr

          let arm = {
            pat:  pat
            expr: expr
            span: arm.span
          }

          state, list.append [arm] arms

      state, :match' {
        input: input
        arms:  arms
        span:  expr.span
      }

    :error span -> state, :error span

local get-var-module env state expr = match expr
  :var expr -> match map.get expr.name env.variables
    :some name -> match name.kind
      :import' ->
        map.get name.unique state.modules
          |> map-some \env. env, name
      _ -> :none
    :none -> :none
  _ -> :none

local find-variable env state name =
  match map.get name env.variables
    :some name -> match name.kind
      :import' ->
        find-imported-variable env state name.label
          |> some-else (:some name)

      _ -> :some name

    :none -> env.imports
      |> find-map \unique.
        map.get unique state.modules
          |> try-map-some \env.
            map.get name env.variables

local find-imported-variable env state name =
  env.imports |> find-map \unique.
    map.get unique state.modules
      |> try-map-some \env. map.get name env.variables

local rename-expr-fields env state fields =
  fields |> list.fold (state, []) \state, fields field.
    let state, field = rename-expr-field env state field
    state, list.append [field] fields

local rename-expr-field env state field =
  let state, expr = rename-expr env state field.expr

  let field = {
    name: field.name
    expr: expr
    span: field.span
  }

  state, field

local rename-let env state stmt =
  let _env, state, ty = rename-option-ty env state stmt.ty

  let env, state, params = rename-pats env state stmt.params :local'
  let state, input = rename-expr env state stmt.input

  let env, state, pat = rename-pat env state stmt.pat :local'

  env, state, {
    ty:     ty
    pat:    pat
    params: params
    input:  input
    span:   stmt.span
  }
