import "std:list"   as list
import "std:map"    as map
import "std:set"    as set
import "std:debug"  as debug
import "std:option" as option
import "std:string" as string
import "std:assert" as assert
import "std:hash"   as hash

import "ka:ir"

simplify program next-id =
  let env = {
    recursive: map.empty
  }

  let state = {
    fuel:    1000000
    next-id: next-id
    cache:   set.empty
  }

  let state, expr = simplify-expr state env program
  expr

local type env = {
  recursive: map nat expr
}

local type state = {
  fuel:    nat
  next-id: nat
  cache:   set nat 
}

local add-var state var =
  let var = {
    name: string.append "'" var.name
    id:   state.next-id
  }

  let state = state with {
    next-id: state.next-id + 1
  }

  state, var

local add-recursive var expr env =
  env with {
    recursive: map.insert var.id expr env.recursive
  }

local remove-recursive var env =
  env with {
    recursive: map.remove var.id env.recursive
  }

local get-recursive var env =
  map.get var.id env.recursive

is state -> env -> expr -> state, expr
local simplify-expr state env expr =
  match state.fuel > 0
    :true ->
      let state = state with {
        fuel: state.fuel - 1
      }

      match expr
        :var var                -> state, :var var
        :lit lit                -> state, :lit lit
        :lam (var, out)         -> simplify-lam state env var out
        :app (lam, in)          -> simplify-app state env lam in
        :rec (binds, out)       -> simplify-rec state env binds out
        :bind (in, var, out)    -> simplify-bind state env in var out
        :field (expr, field)    -> simplify-field state env expr field
        :case (scrutinee, arms) -> simplify-case state env scrutinee arms
        :cons cons              -> simplify-cons state env cons
        :prim prim              -> simplify-prim state env prim
    :false -> state, expr

local simplify-lam state env var out =
  let state, out = simplify-expr state env out
  state, :lam (var, out)

local simplify-app state env lam in =
  let state, lam = simplify-expr state env lam
  let state, in = simplify-expr state env in

  let app = :app (lam, in)

  match lam
    :var var ->
      match get-recursive var env
        :some :lam (v, out) ->
          let env = remove-recursive var env
          let state, out = simplify-expr state env out
          let specialized = (:app (:var var, :var v))

          match size out < 20 and occurs specialized out > 0
            :true ->
              let state, var' = add-var state var
              let out = subst specialized (:var var') out
              let out = subst (:var v) (in) out

              let state, out = simplify-expr state env out
              let expr = :rec ([out, var'], :var var')

              let env = add-recursive var' out env
              simplify-expr state env expr

            :false -> state, app

        _ -> state, app

    :rec (binds, out) ->
      let expr = :rec (binds, :app (out, in))
      simplify-expr state env expr

    :lam (var, out) ->
      let expr = :bind (in, var, out)
      simplify-expr state env expr

    _ -> state, app

local simplify-rec state env binds out =
  let env = binds
    |> fold env \env expr, var.
      add-recursive var expr env

  let vars = deps env.recursive out

  let binds = binds
    |> filter \_, var. set.has var.id vars

  let state, binds = binds
    |> fold (state, []) \state, binds expr, var.
      let env = remove-recursive var env
      let state, expr = simplify-expr state env expr
      state, (expr, var) :: binds

  match binds
    (expr, var) :: [] ->
      match uses var expr == 0, uses var out == 0
        :true, _ ->
          let expr = :bind (expr, var, out)
          simplify-expr state env expr

        :false, :true ->
          simplify-expr state env out

        _, _ ->
          let state, out = simplify-expr state env out
          state, :rec (binds, out)

    [] -> simplify-expr state env out

    _ ->
      let state, out = simplify-expr state env out
      state, :rec (binds, out)

local simplify-bind state env in var out =
  let state, out = simplify-expr state env out
  let uses = uses var out

  match uses == 0
    :true -> state, out
    :false ->
      let state, in = simplify-expr state env in
      let cost = cost in * uses

      match cost < 50
        :true ->
          let out = subst (:var var) in out
          simplify-expr state env out

        :false ->
          state, :bind (in, var, out)

local simplify-field state env expr field =
  let state, expr = simplify-expr state env expr

  match expr
    :cons cons ->
      match cons, field
        :tuple fields, :index n ->
          let field = nth n fields
            |> assert-some "invalid number of tuple fields"

          state, field

        _ -> state, :field (expr, field)
    _ -> state, :field (expr, field)

local simplify-case state env scrutinee arms =
  let state, scrutinee = simplify-expr state env scrutinee

  match scrutinee
    :cons cons ->
      arms
        |> find-map \alt, expr.
          match cons, alt
            :variant (n, p), :variant (n', p') ->
              match n == n', p, p'
                :true, :some p, :some p' -> :some :bind (p, p', expr)
                :true, :none, :none -> :some expr
                _ -> :none

            :cons (h, t), :cons (h', t') ->
              :some :bind (h, h', :bind (t, t', expr))

            :empty, :empty -> :some expr

            _, :default -> :some expr
            _, _ -> :none
        |> assert-some "cons should always match one arm"
        |> simplify-expr state env

    _ ->
      let state, arms = arms
        |> rfold (state, []) \state, arms alt, expr.
          let state, expr = simplify-expr state env expr
          state, (alt, expr) :: arms

      state, :case (scrutinee, arms)

local simplify-cons state env cons =
  let state, cons = match cons
    :empty -> state, :empty

    :cons (head, tail) ->
      let state, head = simplify-expr state env head
      let state, tail = simplify-expr state env tail
      state, :cons (head, tail)

    :variant (name, payload) ->
      let state, payload = match payload
        :some payload ->
          let state, payload = simplify-expr state env payload
          state, :some payload
        :none -> state, :none

      state, :variant (name, payload)

    :record (from, fields) ->
      let state, from = match from
        :some from ->
          let state, from = simplify-expr state env from
          state, :some from
        :none -> state, :none

      let state, fields = fields
        |> rfold (state, []) \state, fields name, expr.
          let state, expr = simplify-expr state env expr
          state, (name, expr) :: fields

      state, :record (from, fields)

    :tuple fields ->
      let state, fields = fields
        |> rfold (state, []) \state, fields field.
          let state, field = simplify-expr state env field
          state, field :: fields

      state, :tuple fields

  state, :cons cons

local simplify-prim state env prim =
  match prim
    :extern' extern' -> state, :prim :extern' extern'

    :unary (op, expr) ->
      let state, expr = simplify-expr state env expr
      state, :prim :unary (op, expr)

    :binary (op, lhs, rhs) ->
      let state, lhs = simplify-expr state env lhs
      let state, rhs = simplify-expr state env rhs

      match lhs, rhs
        :lit lhs, :lit rhs ->
          let lit = match op, lhs, rhs
            :add _, :nat' lhs, :nat' rhs -> :some :nat' (lhs + rhs)
            :add _, :int' lhs, :int' rhs -> :some :int' (lhs + rhs)
            :add _, :real' lhs, :real' rhs -> :some :real' (lhs + rhs)

            :sub _, :nat' lhs, :nat' rhs -> :some :nat' (lhs - rhs)
            :sub _, :int' lhs, :int' rhs -> :some :int' (lhs - rhs)
            :sub _, :real' lhs, :real' rhs -> :some :real' (lhs - rhs)

            :mul _, :nat' lhs, :nat' rhs -> :some :nat' (lhs * rhs)
            :mul _, :int' lhs, :int' rhs -> :some :int' (lhs * rhs)
            :mul _, :real' lhs, :real' rhs -> :some :real' (lhs * rhs)

            :div _, :real' lhs, :real' rhs -> :some :real' (lhs / rhs)

            :str-prepend, :str' lhs, :str' rhs ->
              :some :str' string.prepend lhs rhs

            _ -> :none

          let expr = match lit
            :some lit -> :lit lit
            :none -> :prim :binary (op, :lit lhs, :lit rhs)

          state, expr

        _, _ -> state, :prim :binary (op, lhs, rhs)

is expr -> expr -> expr -> expr
local subst a b expr =
  match expr == a
    :true -> b
    :false ->
      match expr
        :var var -> :var var
        :lit lit -> :lit lit

        :lam (var, out) ->
          let out = subst a b out
          :lam (var, out)

        :app (lam, in) ->
          let lam = subst a b lam
          let in = subst a b in
          :app (lam, in)

        :rec (binds, out) ->
          let binds = binds
            |> map \expr, var. subst a b expr, var
          let out = subst a b out
          :rec (binds, out)

        :bind (in, var, out) ->
          let in = subst a b in
          let out = subst a b out
          :bind (in, var, out)

        :field (expr, field) ->
          let expr = subst a b expr
          :field (expr, field)

        :case (scrutinee, arms) ->
          let scrutinee = subst a b scrutinee
          let arms = arms
            |> map \alt, expr.
              alt, subst a b expr
          :case (scrutinee, arms)

        :cons cons ->
          let cons = match cons
            :empty -> :empty

            :cons (head, tail) ->
              let head = subst a b head
              let tail = subst a b tail
              :cons (head, tail)

            :variant (name, payload) ->
              let payload = map-some (subst a b) payload
              :variant (name, payload)

            :record (from, fields) ->
              let from = map-some (subst a b) from
              let fields = fields
                |> map \name, expr.
                  name, subst a b expr
              :record (from, fields)
            :tuple fields ->
              let fields = map (subst a b) fields
              :tuple fields

          :cons cons

        :prim prim ->
          match prim
            :extern' extern' -> :prim :extern' extern'

            :unary (op, expr) ->
              let expr = subst a b expr
              :prim :unary (op, expr)

            :binary (op, lhs, rhs) ->
              let lhs = subst a b lhs
              let rhs = subst a b rhs
              :prim :binary (op, lhs, rhs)

is expr -> nat
local size expr =
  let sum = fold 0 \x y. x + y

  match expr
    :var _ -> 1
    :lit _ -> 1
    :lam (_, out) -> size out + 1
    :app (lam, in) -> size lam + size in + 1

    :rec (binds, out) ->
      let binds = binds
        |> map \expr, _. size expr
        |> sum

      binds + size out + 1

    :bind (in, _, out) -> size in + size out + 1

    :field (expr, _) -> size expr + 1

    :case (scrutinee, arms) ->
      let arms = arms
        |> map \_, expr. size expr
        |> fold 0 \x y. x + y

      size scrutinee + arms + 1

    :cons cons ->
      match cons
        :empty -> 1

        :cons (head, tail) -> size head + size tail + 1

        :variant (_, payload) ->
          let payload = payload
            |> map-some size
            |> some-or 0

          payload + 1

        :record (from, fields) ->
          let from = from
            |> map-some size
            |> some-or 0

          let fields = fields
            |> map \_, expr. size expr
            |> fold 0 \x y. x + y

          from + fields + 1

        :tuple fields ->
          let fields = fields
            |> map size
            |> fold 0 \x y. x + y

          fields + 1

    :prim prim ->
      match prim
        :extern' _ -> 1
        :unary (_, expr) -> size expr + 1
        :binary (_, lhs, rhs) -> size lhs + size rhs + 1

is expr -> nat
local cost expr =
  match expr
    :var _ -> 0
    :lit _ -> 0
    :lam _ -> 1
    :app (lam, in) -> cost lam + cost in + 1
    :bind (in, _, out) -> cost in + cost out
    _ -> 1

is var -> expr -> nat
local uses var expr = occurs (:var var) expr

is expr -> expr -> nat
local occurs e =
  fold-expr 0 \n expr.
    match expr == e
      :true -> n + 1
      :false -> n

local deps binds expr =
  deps-iter binds set.empty expr

local deps-iter binds vars =
  fold-expr vars \vars expr.
    match expr
      :var var ->
        match set.has var.id vars
          :true -> vars
          :false ->
            let vars = set.insert var.id vars

            match map.get var.id binds
              :some expr -> deps-iter binds vars expr
              :none -> vars
      _ -> vars

is 'acc -> ('acc -> expr -> 'acc) -> expr -> 'acc
local fold-expr acc f expr =
  let then expr acc =
    fold-expr acc f expr

  let acc = match expr
    :var _ -> acc

    :lit _ -> acc

    :lam (_, out) ->
      then out acc

    :app (lam, in) ->
      acc
        |> then lam
        |> then in

    :rec (binds, out) ->
      binds
        |> fold acc \acc expr, var.
          then expr acc
        |> then out

    :bind (in, _, out) ->
      acc
        |> then in
        |> then out

    :field (expr, _) -> then expr acc

    :case (scrutinee, arms) ->
      arms
        |> fold acc \acc _, expr. then expr acc
        |> then scrutinee

    :cons cons ->
      match cons
        :empty -> acc

        :cons (head, tail) ->
          acc
            |> then head
            |> then tail

        :variant (_, payload) ->
          payload
            |> map-some \payload. then payload acc
            |> some-or acc

        :record (from, fields) ->
          let acc = from
            |> map-some \from. then from acc
            |> some-or acc

          fields
            |> fold acc \acc _, expr.
              then expr acc

        :tuple fields ->
          fields
            |> fold acc \acc expr.
              then expr acc

    :prim prim ->
      match prim
        :extern' _ -> acc

        :unary (_, expr) ->
          then expr acc

        :binary (_, lhs, rhs) ->
          acc
            |> then lhs
            |> then rhs

  f acc expr
