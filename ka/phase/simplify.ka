import "std:list"   as list
import "std:map"    as map
import "std:set"    as set
import "std:debug"  as debug
import "std:option" as option
import "std:string" as string
import "std:assert" as assert

import "ka:ir"

simplify program =
  let globals = program
    |> fold map.empty \globals var, expr.
      map.insert var.id expr globals

  let env = {
    vars:    map.empty
    globals: globals
  }

  let state = {
    next-id: 10000000
    inline:  map.empty
  }

  program |> list.map \var, expr.
    let _, expr = simplify-expr state env expr
    var, expr

local type env = {
  vars:    map nat expr
  globals: map nat expr
}

local type state = {
  next-id: nat
  inline:  map nat nat
}

local subst-var var expr env =
  env with {
    vars: map.insert var.id expr env.vars
  }

local add-var state =
  let var = {
    name: string.prepend "_" (string.format state.next-id)
    id:   state.next-id
  }

  let state = state with {
    next-id: state.next-id + 1
  }

  state, var

local remove-var var env =
  env with {
    vars: map.remove var.id env.vars
  }

local get-var var env =
  map.get var.id env.vars

local get-global var env =
  map.get var.id env.globals

local add-inline var state =
  let n = get-inline var state + 1

  state with {
    inline: map.insert var.id n state.inline
  }

local get-inline var state =
  map.get var.id state.inline |> some-or 0

is state -> env -> expr -> state, expr
local simplify-expr state env expr =
  match expr
    :var var ->
      let expr = get-var var env
        |> some-or expr

      state, expr

    :lit lit -> state, :lit lit

    :lam (var, out) ->
      let state, out = simplify-expr state env out
      state, :lam (var, out)

    :app (lam, in) ->
      let state, lam = simplify-expr state env lam
      let state, in = simplify-expr state env in

      let app = :app (lam, in)

      match lam
        :var global -> match get-global global env
          :some expr -> match expr
            :lam (_, out) -> match should-inline state env global out
              :true ->
                let state = add-inline global state
                let app = :app (expr, in)
                simplify-expr state env app
              :false -> state, app

            _ -> state, app
          :none -> state, app

        :lam (var, out) ->
          let state, var = add-var state
          let expr = :bind (in, var, out)
          simplify-expr state env expr

        _ -> state, app

    :field (expr, field) ->
      let state, expr = simplify-expr state env expr

      match expr
        :cons cons ->
          match cons, field
            :tuple fields, :index n ->
              let field = nth n fields
                |> assert-some "invalid number of tuple fields"

              state, field

            _ -> state, :field (expr, field)
        _ -> state, :field (expr, field)

    :bind (in, var, out) ->
      let state, out = simplify-expr state env out
      let uses = uses var out

      match uses == 0
        :true -> state, out
        :false ->
          let state, in = simplify-expr state env in
          let cost = cost in * uses

          match cost < 50
            :true ->
              let env = subst-var var in env
              simplify-expr state env out

            :false ->
              state, :bind (in, var, out)

    :case (scrutinee, arms) ->
      let state, scrutinee = simplify-expr state env scrutinee

      match scrutinee
        :cons cons ->
          arms
            |> find-map \alt, expr.
              match cons, alt
                :variant (n, p), :variant (n', p') ->
                  match n == n', p, p'
                    :true, :some p, :some p' -> :some :bind (p, p', expr)
                    :true, :none, :none -> :some expr
                    _ -> :none

                :cons (h, t), :cons (h', t') ->
                  :some :bind (h, h', :bind (t, t', expr))

                :empty, :empty -> :some expr

                _, :default -> :some expr
                _, _ -> :none
            |> assert-some "cons should always match one arm"
            |> simplify-expr state env

        _ ->
          let state, arms = arms
            |> rfold (state, []) \state, arms alt, expr.
              let state, expr = simplify-expr state env expr
              state, (alt, expr) :: arms

          state, :case (scrutinee, arms)

    :cons cons ->
      let state, cons = match cons
        :empty -> state, :empty

        :cons (head, tail) ->
          let state, head = simplify-expr state env head
          let state, tail = simplify-expr state env tail
          state, :cons (head, tail)

        :variant (name, payload) ->
          let state, payload = match payload
            :some payload ->
              let state, payload = simplify-expr state env payload
              state, :some payload
            :none -> state, :none

          state, :variant (name, payload)

        :record (from, fields) ->
          let state, from = match from
            :some from ->
              let state, from = simplify-expr state env from
              state, :some from
            :none -> state, :none

          let state, fields = fields
            |> rfold (state, []) \state, fields name, expr.
              let state, expr = simplify-expr state env expr
              state, (name, expr) :: fields

          state, :record (from, fields)

        :tuple fields ->
          let state, fields = fields
            |> rfold (state, []) \state, fields field.
              let state, field = simplify-expr state env field
              state, field :: fields

          state, :tuple fields

      state, :cons cons

    :prim prim ->
      match prim
        :extern' extern' -> state, :prim :extern' extern'

        :unary (op, expr) ->
          let state, expr = simplify-expr state env expr
          state, :prim :unary (op, expr)

        :binary (op, lhs, rhs) ->
          let state, lhs = simplify-expr state env lhs
          let state, rhs = simplify-expr state env rhs

          match lhs, rhs
            :lit lhs, :lit rhs ->
              let lit = match op, lhs, rhs
                :add _, :nat' lhs, :nat' rhs -> :some :nat' (lhs + rhs)
                :add _, :int' lhs, :int' rhs -> :some :int' (lhs + rhs)
                :add _, :real' lhs, :real' rhs -> :some :real' (lhs + rhs)

                :sub _, :nat' lhs, :nat' rhs -> :some :nat' (lhs - rhs)
                :sub _, :int' lhs, :int' rhs -> :some :int' (lhs - rhs)
                :sub _, :real' lhs, :real' rhs -> :some :real' (lhs - rhs)

                :mul _, :nat' lhs, :nat' rhs -> :some :nat' (lhs * rhs)
                :mul _, :int' lhs, :int' rhs -> :some :int' (lhs * rhs)
                :mul _, :real' lhs, :real' rhs -> :some :real' (lhs * rhs)

                :div _, :real' lhs, :real' rhs -> :some :real' (lhs / rhs)

                :str-prepend, :str' lhs, :str' rhs ->
                  :some :str' string.prepend lhs rhs

                _ -> :none

              let expr = match lit
                :some lit -> :lit lit
                :none -> :prim :binary (op, :lit lhs, :lit rhs)

              state, expr

            _, _ -> state, :prim :binary (op, lhs, rhs)

local should-inline state env var expr =
  let inline-limit = 1
  let size-limit = 50

  let inline = get-inline var state
  let size = size expr

  inline < inline-limit and size < size-limit

is expr -> nat
local size expr =
  match expr
    :var _ -> 1
    :lit _ -> 1
    :lam (_, out) -> size out + 1
    :app (lam, in) -> size lam + size in + 1
    :field (expr, _) -> size expr + 1
    :bind (in, _, out) -> size in + size out + 1

    :case (scrutinee, arms) ->
      let arms = arms
        |> map \_, expr. size expr
        |> fold 0 \x y. x + y

      size scrutinee + arms + 1

    :cons cons ->
      match cons
        :empty -> 1

        :cons (head, tail) -> size head + size tail + 1

        :variant (_, payload) ->
          let payload = payload
            |> map-some size
            |> some-or 0

          payload + 1

        :record (from, fields) ->
          let from = from
            |> map-some size
            |> some-or 0

          let fields = fields
            |> map \_, expr. size expr
            |> fold 0 \x y. x + y

          from + fields + 1

        :tuple fields ->
          let fields = fields
            |> map size
            |> fold 0 \x y. x + y

          fields + 1

    :prim prim ->
      match prim
        :extern' _ -> 1
        :unary (_, expr) -> size expr + 1
        :binary (_, lhs, rhs) -> size lhs + size rhs + 1

is expr -> nat
local cost expr =
  match expr
    :var _ -> 0
    :lit _ -> 0
    :lam _ -> 1
    :app (lam, in) -> cost lam + cost in + 1
    :bind (in, _, out) -> cost in + cost out
    _ -> 1

is var -> expr -> nat
local uses var expr =
  match expr
    :var var' ->
      match var' == var
        :true -> 1
        :false -> 0

    :lit _ -> 0

    :lam (_, output) -> uses var output

    :app (lambda, input) -> uses var lambda + uses var input

    :field (expr, _) -> uses var expr

    :bind (input, _, output) -> uses var input + uses var output

    :case (scrutinee, arms) ->
      let n = uses var scrutinee

      arms |> fold n \n _, expr.
        n + uses var expr

    :cons cons ->
      match cons
        :empty -> 0

        :cons (head, tail) -> uses var head + uses var tail

        :variant (_, :some payload) -> uses var payload
        :variant (_, :none) -> 0

        :record (from, fields) ->
          let n = from
            |> map-some (uses var)
            |> some-or 0

          fields |> fold n \n _, expr.
            n + uses var expr

        :tuple fields ->
          fields |> fold 0 \n expr.
            n + uses var expr

    :prim prim ->
      match prim
        :extern' _ -> 0
        :unary (op, expr) -> uses var expr
        :binary (op, lhs, rhs) -> uses var lhs + uses var rhs
