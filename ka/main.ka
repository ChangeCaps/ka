import "std:io" as io
import "std:fs" as fs
import "std:string"

import "ka:parse/lex"
import "ka:parse/parser"
import "ka:diagnostic/format"
import "ka:phase/rename"
import "ka:parse"

main = do
  let file = {
    path: "test.ka"
  }

  let input <- fs.read file.path

  match input
    :err _ -> do {}
    :ok input -> do
      let ts, ds = lex file input
      print-all ds

      let ast = parse ts module

      match ast
        :none -> do {}
        :some (ast, ds) -> do
          print-all ds

          let renamed = rename ["test", ast]

          do {}

  do {}
