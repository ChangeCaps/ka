import "std:io" as io
import "std:fs" as fs
import "std:debug"
import "std:string" as string
import "std:result" as result
import "std:option" as option
import "std:list"   as list

import "ka:parse/lex"
import "ka:parse/parser"
import "ka:diagnostic/format"
import "ka:phase/rename"
import "ka:phase/typecheck"
import "ka:phase/lower"
import "ka:phase/simplify"
import "ka:parse"
import "ka:lua"
import "ka:ir"

main = do
  let result <- compiler
    |> add-package "ka" "ka"

  let result <- result
    |> try-then \compiler.
      add-package "std" "std2" compiler

  match result
    :ok compiler -> compile compiler (:some "ka:main")
    :err e -> print e

compiler = {
  files: []
  diagnostics: []
}

compile compiler main = do
  let renamed, main, ds' = rename compiler.files main
  let ds = append ds' compiler.diagnostics

  println "renamed"

  let typechecked, ds' = typecheck renamed
  let ds = append ds' ds

  println "type checked"

  match main
    :some main -> do
      print-all ds

      let ir, next-id = lower typechecked main

      let lua <- lua ir
      fs.write "test.lua" lua

      do {}
    :none -> do
      println "could not find main"

      print-all ds

  do {}

add-package name path compiler =
  let name = string.append ":" name
  add-package-dir name path compiler

add-package-dir parent path compiler = do
  let result <- fs.read-dir path

  result |> try-then \paths. do
    paths |> mfold (:ok compiler) \compiler entry. do
      compiler |> try-then (add-package-path parent entry)

add-package-path parent path compiler = do
  let is-dir <- fs.is-dir path

  match is-dir
    :true -> match file-name path
      :some name -> do
        let name = parent
          |> string.append name
          |> string.append "/"

        add-package-dir name path compiler
      :none -> do :ok compiler

    :false -> add-package-file parent path compiler

add-package-file parent path compiler =
  match file-extension path, file-stem path
    :some "ka", :some name -> do
      let result <- fs.read path

      result |> try-then \input. do
        let file = {
          path: path
        }

        let name = string.append name parent
        println name

        let ts, ds = lex file input
        let ast, ds' = parse ts module
          |> assert-some "parsing never fails"

        let compiler = compiler with {
          files: (name, ast) :: compiler.files 
          diagnostics: compiler.diagnostics
            |> list.append ds
            |> list.append ds'
        }

        do :ok compiler
    _ -> do :ok compiler

file-name path =
  string.split "/" path |> last

file-extension path =
  file-name path
    |> try-map-some \name.
      string.find "." name
        |> map-some \n.
          let _, extension = string.split-at (n + 1) name
          extension

file-stem path =
  file-name path
    |> try-map-some \name.
      string.find "." name
        |> map-some \n.
          let stem, _ = string.split-at n name
          stem
