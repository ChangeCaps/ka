import "std:io" as io
import "std:fs" as fs
import "std:string"
import "std:list"

import "ka:parse/lex"
import "ka:parse/parser"
import "ka:diagnostic/format"
import "ka:phase/rename"
import "ka:parse"

main = do
  let file = {
    path: "test.ka"
  }

  let input <- fs.read file.path

  match input
    :err _ -> do {}
    :ok input -> do
      let ts, ds = lex file input
      let ast = parse ts module

      match ast
        :none -> do {}
        :some (ast, ds') -> do
          let ds = append ds' ds

          let renamed, ds' = rename ["test", ast]
          let ds = append ds' ds

          print-all ds

          do {}

  do {}
