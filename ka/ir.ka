import "std:option" as option
import "std:string" as string
import "std:list" as list

type expr =
  | :atom atom
  | :lam (var, expr)
  | :app (expr, atom)
  | :cons (cons, [expr])
  | :case (expr, case)

type atom =
  | :var var
  | :lit lit

type var = {
  id:   nat
  name: str
}

type lit =
  | :str' str
  | :nat' nat
  | :int' int
  | :real' real

type cons = {
  id:   nat
  name: str
}

type case =
  | :cons ([cons, [var], expr], option (var, expr))
  | :lit ([lit, expr], option (var, expr))
