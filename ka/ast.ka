import "std:option" as option

import "ka:diagnostic/span" as span

type module-def =
  | :import' import-def
  | :type'   type-def
  | :global  global-def
  | :error   span

type def =
  | :import' import-def
  | :type'   type-def
  | :error   span

type ty 'name =
  | :str'    str-ty 'name
  | :nat'    nat-ty 'name
  | :int'    int-ty 'name
  | :real'   real-ty 'name
  | :var     var-ty 'name
  | :paren   paren-ty 'name
  | :list    list-ty 'name
  | :lambda  lambda-ty 'name
  | :generic generic-ty 'name
  | :record  record-ty 'name
  | :tuple   tuple-ty 'name
  | :union   union-ty 'name
  | :apply   apply-ty 'name
  | :action  action-ty 'name
  | :field   field-ty 'name
  | :error   span

type pat 'name =
  | :paren   paren-pat 'name
  | :wild    wild-pat 'name
  | :bind    bind-pat 'name
  | :str'    str-pat 'name
  | :empty   empty-pat 'name
  | :cons    cons-pat 'name
  | :tuple   tuple-pat 'name
  | :variant variant-pat 'name
  | :error   span

type expr 'name =
  | :paren    paren-expr 'name
  | :nat'     nat-expr  'name
  | :str'     str-expr 'name
  | :var      var-expr 'name
  | :field    field-expr 'name
  | :with'    with-expr 'name
  | :apply    apply-expr 'name
  | :pipe     pipe-expr 'name
  | :lambda   lambda-expr 'name
  | :list     list-expr 'name
  | :variant  variant-expr 'name
  | :record   record-expr 'name
  | :tuple    tuple-expr 'name
  | :unary    unary-expr 'name
  | :binary   binary-expr 'name
  | :block    block-expr 'name
  | :do'      do-expr 'name
  | :do-block do-block-expr 'name
  | :match'   match-expr 'name
  | :error    span

type import-def = {
  path: str
  name: option str
  span: span
}

type type-def = {
  is-local: bool
  name:     str
  params:   [str]
  ty:       ty str
  span:     span
}

type global-def = {
  is-local: bool
  ty:       option (ty str)
  pat:      pat str
  params:   [pat str]
  output:   expr str
  span:     span
}

type nat-ty 'name = {
  span: span
}

type int-ty 'name = {
  span: span
}

type real-ty 'name = {
  span: span
}

type str-ty 'name = {
  span: span
}

type var-ty 'name = {
  name: 'name
  span: span
}

type paren-ty 'name = {
  ty:   ty 'name
  span: span
}

type list-ty 'name = {
  item: ty 'name
  span: span
}

type lambda-ty 'name = {
  input:  ty 'name
  output: ty 'name
  span:   span
}

type action-ty 'name = {
  output: ty 'name
  span:   span
}

type generic-ty 'name = {
  name: 'name
  span: span
}

type tuple-ty 'name = {
  fields: [ty 'name]
  span:   span
}

type record-ty 'name = {
  fields: [ty-field 'name]
  span:   span
}

type union-ty 'name = {
  variants: [ty-variant 'name]
  span:     span
}

type apply-ty 'name = {
  lambda: ty 'name
  input:  ty 'name
  span:   span
}

type field-ty 'name = {
  input: ty 'name
  name:  str
  span:  span
}

type ty-field 'name = {
  name: str
  ty:   ty 'name
  span: span
}

type ty-variant 'name = {
  name:    str
  payload: option (ty 'name)
  span:    span
}

type paren-pat 'name = {
  pat:  pat 'name
  span: span
}

type wild-pat 'name = {
  span: span
}

type bind-pat 'name = {
  name: 'name
  span: span
}

type str-pat 'name = {
  value: str
  span:  span
}

type empty-pat 'name = {
  span: span
}

type cons-pat 'name = {
  first: pat 'name
  rest:  pat 'name
  span:  span
}

type tuple-pat 'name = {
  fields: [pat 'name]
  span:   span
}

type variant-pat 'name = {
  name:    str
  payload: option (pat 'name)
  span:    span
}

type paren-expr 'name = {
  expr: expr 'name
  span: span
}

type nat-expr 'name = {
  value: str
  span:  span
}

type str-expr 'name = {
  value: str
  span:  span
}

type var-expr 'name = {
  name: 'name
  span: span
}

type field-expr 'name = {
  input:     expr 'name
  name:      str
  name-span: span
  span:      span
}

type with-expr 'name = {
  input:  expr 'name
  fields: [expr-field 'name]
  span:   span
}

type apply-expr 'name = {
  lambda: expr 'name
  input:  expr 'name
  span:   span
}

type pipe-expr 'name = {
  input:  expr 'name
  lambda: expr 'name
  span:   span
}

type lambda-expr 'name = {
  params: [pat 'name]
  output: expr 'name
  span:   span
}

type list-expr 'name = {
  items: [expr 'name]
  span:  span
}

type variant-expr 'name = {
  name:    str
  payload: option (expr 'name)
  span:    span
}

type record-expr 'name = {
  fields: [expr-field 'name]
  span:   span
}

type tuple-expr 'name = {
  fields: [expr 'name]
  span:   span
}

type unary-expr 'name = {
  op:      unop
  op-span: span
  input:   expr 'name
  span:    span
}

type binary-expr 'name = {
  lhs:     expr 'name
  op:      binop
  op-span: span
  rhs:     expr 'name
  span:    span
}

type block-expr 'name = {
  stmts:  [let' 'name]
  output: expr 'name
  span:   span
}

type do-expr 'name = {
  expr: expr 'name
  span: span
}

type do-block-expr 'name = {
  stmts: [do-block-stmt 'name]
  span:  span
}

type match-expr 'name = {
  input: expr 'name
  arms:  [match-arm 'name]
  span:  span
}

type do-block-stmt 'name =
  | :let' let' 'name
  | :bind bind 'name
  | :expr expr 'name

type let' 'name = {
  ty:     option (ty 'name)
  pat:    pat 'name
  params: [pat 'name]
  input:  expr 'name
  span:   span
}

type bind 'name = {
  ty:     option (ty 'name)
  pat:    pat 'name
  params: [pat 'name]
  input:  expr 'name
  span:   span
}

type expr-field 'name = {
  name: str
  expr: expr 'name
  span: span
}

type match-arm 'name = {
  pat:  pat 'name
  expr: expr 'name
  span: span
}

type unop =
  | :nat'
  | :int'
  | :real'
  | :not

type binop =
  | :add
  | :sub
  | :mul
  | :div
  | :gt
  | :lt
  | :ge
  | :le
  | :eq
  | :ne
  | :land
  | :lor
  | :cons

is ty 'a -> span
ty-span ty =
  match ty
    :str' ty    -> ty.span
    :nat' ty    -> ty.span
    :int' ty    -> ty.span
    :real' ty   -> ty.span
    :var ty     -> ty.span
    :paren ty   -> ty.span
    :list ty    -> ty.span
    :lambda ty  -> ty.span
    :generic ty -> ty.span
    :record ty  -> ty.span
    :tuple ty   -> ty.span
    :union ty   -> ty.span
    :apply ty   -> ty.span
    :action ty  -> ty.span
    :field ty   -> ty.span
    :error span -> span

is pat 'a -> span
pat-span pat =
  match pat
    :paren pat   -> pat.span
    :wild pat    -> pat.span
    :bind pat    -> pat.span
    :str' pat    -> pat.span
    :empty pat   -> pat.span
    :cons pat    -> pat.span
    :tuple pat   -> pat.span
    :variant pat -> pat.span
    :error span  -> span

is expr 'a -> span
expr-span expr =
  match expr 
    :paren expr    -> expr.span
    :nat' expr     -> expr.span
    :str' expr     -> expr.span
    :var  expr     -> expr.span
    :field expr    -> expr.span
    :with' expr    -> expr.span
    :apply expr    -> expr.span
    :pipe expr     -> expr.span
    :lambda expr   -> expr.span
    :list expr     -> expr.span
    :variant expr  -> expr.span
    :record expr   -> expr.span
    :tuple expr    -> expr.span
    :unary expr    -> expr.span
    :binary expr   -> expr.span
    :block expr    -> expr.span
    :do' expr      -> expr.span
    :do-block expr -> expr.span
    :match' expr   -> expr.span
    :error  span   -> span
