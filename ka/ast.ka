import "std:option" as option
import "std:list"   as list

import "ka:diagnostic/span" as span

type module = {
  defs: [module-def]
}

type module-def =
  | :import' import-def
  | :type'   type-def
  | :global  global-def
  | :error   span

type def =
  | :import' import-def
  | :type'   type-def
  | :error   span

type ty =
  | :nat'    nat-ty
  | :int'    int-ty
  | :real'   real-ty
  | :str'    str-ty
  | :paren   paren-ty
  | :list    list-ty
  | :lambda  lambda-ty
  | :generic generic-ty
  | :record  record-ty
  | :tuple   tuple-ty
  | :union   union-ty
  | :alias   alias-ty
  | :action  action-ty
  | :error   span

type pat =
  | :paren   paren-pat
  | :wild    wild-pat
  | :bind    bind-pat
  | :str'    str-pat
  | :empty   empty-pat
  | :cons    cons-pat
  | :tuple   tuple-pat
  | :variant variant-pat
  | :error   span

type expr =
  | :paren    paren-expr
  | :nat'     nat-expr
  | :str'     str-expr
  | :var      var-expr
  | :field    field-expr
  | :with'    with-expr
  | :apply    apply-expr
  | :pipe     pipe-expr
  | :lambda   lambda-expr
  | :list     list-expr
  | :cons     cons-expr
  | :variant  variant-expr
  | :record   record-expr
  | :tuple    tuple-expr
  | :unary    unary-expr
  | :binary   binary-expr
  | :block    block-expr
  | :do'      do-expr
  | :do-block do-block-expr
  | :match'   match-expr
  | :error    span

type import-def = {
  path: str
  name: option str
  span: span
}

type type-def = {
  is-local: bool
  name:     str
  params:   [str]
  ty:       ty
  span:     span
}

type global-def = {
  is-local: bool
  ty:       option ty
  pat:      pat
  params:   [pat]
  output:   expr
  span:     span
}

type nat-ty = {
  span: span
}

type int-ty = {
  span: span
}

type real-ty = {
  span: span
}

type str-ty = {
  span: span
}

type paren-ty = {
  ty:   ty
  span: span
}

type list-ty = {
  item: ty
  span: span
}

type lambda-ty = {
  input:  ty
  output: ty
  span:   span
}

type action-ty = {
  output: ty
  span:   span
}

type generic-ty = {
  name: str
  span: span
}

type tuple-ty = {
  fields: [ty]
  span:   span
}

type record-ty = {
  fields: [ty-field]
  span:   span
}

type union-ty = {
  variants: [ty-variant]
  span:     span
}

type alias-ty = {
  from: option str
  name: str
  args: [ty]
  span: span
}

type ty-field = {
  name: str
  ty:   ty
  span: span
}

type ty-variant = {
  name:    str
  payload: option ty
  span:    span
}

type paren-pat = {
  pat:  pat
  span: span
}

type wild-pat = {
  span: span
}

type bind-pat = {
  name: str
  span: span
}

type str-pat = {
  value: str
  span:  span
}

type empty-pat = {
  span: span
}

type cons-pat = {
  first: pat
  rest:  pat
  span:  span
}

type tuple-pat = {
  fields: [pat]
  span:   span
}

type variant-pat = {
  name:    str
  payload: option pat
  span:    span
}

type paren-expr = {
  expr: expr
  span: span
}

type nat-expr = {
  value: str
  span:  span
}

type str-expr = {
  value: str
  span:  span
}

type var-expr = {
  name: str
  span: span
}

type field-expr = {
  input: expr
  name:  str
  span:  span
}

type with-expr = {
  input:  expr
  fields: [expr-field]
  span:   span
}

type apply-expr = {
  lambda: expr
  args:   [expr]
  span:   span
}

type pipe-expr = {
  input:   expr
  lambdas: [expr]
  span:    span
}

type lambda-expr = {
  params: [pat]
  output: expr
  span:   span
}

type list-expr = {
  items: [expr]
  span:  span
}

type cons-expr = {
  first: expr
  rest:  expr
  span:  span
}

type variant-expr = {
  name:    str
  payload: option expr
  span:    span
}

type record-expr = {
  fields: [expr-field]
  span:   span
}

type tuple-expr = {
  fields: [expr]
  span:   span
}

type unary-expr = {
  op:    unop
  input: expr
  span:  span
}

type binary-expr = {
  lhs:  expr
  op:   binop
  rhs:  expr
  span: span
}

type block-expr = {
  stmts:  [let']
  output: expr
  span:   span
}

type do-expr = {
  expr: expr
  span: span
}

type do-block-expr = {
  stmts: [do-block-stmt]
  span:  span
}

type match-expr = {
  input: expr
  arms:  [match-arm]
  span:  span
}

type do-block-stmt =
  | :let' let'
  | :bind bind
  | :expr expr

type let' = {
  ty:     option ty
  pat:    pat
  params: [pat]
  input:  expr
  span:   span
}

type bind = {
  ty:     option ty
  pat:    pat
  params: [pat]
  input:  expr
  span:   span
}

type expr-field = {
  name: str
  expr: expr
  span: span
}

type match-arm = {
  pat:  pat
  expr: expr
  span: span
}

type unop =
  | :nat'
  | :int'
  | :real'
  | :not

type binop =
  | :add
  | :sub
  | :mul
  | :div
  | :gt
  | :lt
  | :ge
  | :le
  | :eq
  | :ne
  | :land
  | :lor

