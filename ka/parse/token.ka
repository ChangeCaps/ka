import "std:list" as list

import "ka:diagnostic/span" as span

type tokens = list (token, span)

type token =
  | :ident str
  | :string str
  | :number nat

  | :invalid str
  | :whitespace
  | :newline
  | :indent
  | :dedent
  | :eof

  | :and'
  | :as'
  | :do'
  | :extern'
  | :import'
  | :int'
  | :is'
  | :let'
  | :local'
  | :match'
  | :nat'
  | :real'
  | :or'
  | :str'
  | :type'
  | :with'

  | :eq
  | :colon
  | :semi
  | :dot
  | :comma
  | :plus
  | :minus
  | :star
  | :slash
  | :gt
  | :lt
  | :pipe
  | :bang
  | :under
  | :back
  | :quote

  | :open-paren
  | :close-paren
  | :open-brace
  | :close-brace
  | :open-bracket
  | :close-bracket

  | :coloncolon
  | :rightarrow
  | :leftarrow
  | :pipegt
  | :eqeq
  | :bangeq
  | :gteq
  | :lteq
