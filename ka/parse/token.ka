type token =
  | :ident str
  | :string str
  | :number str
  | :invalid str

  | :whitespace
  | :newline
  | :indent
  | :dedent
  | :eof

  | :and'
  | :as'
  | :do'
  | :extern'
  | :import'
  | :int'
  | :is'
  | :let'
  | :local'
  | :match'
  | :nat'
  | :real'
  | :or'
  | :str'
  | :type'
  | :with'

  | :eq
  | :colon
  | :semi
  | :dot
  | :comma
  | :plus
  | :minus
  | :star
  | :slash
  | :gt
  | :lt
  | :pipe
  | :bang
  | :under
  | :back
  | :quote

  | :open-paren
  | :open-brace
  | :open-bracket
  | :close-paren
  | :close-brace
  | :close-bracket

  | :colon-colon
  | :right-arrow
  | :left-arrow
  | :pipe-right
  | :pipe-left
  | :eq-eq
  | :bang-eq
  | :gt-eq
  | :lt-eq
