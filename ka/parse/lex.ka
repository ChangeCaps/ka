import "std:list" as list
import "std:string" as string
import "std:option" as option

import "ka:diagnostic/diagnostic"
import "ka:diagnostic/file"
import "ka:diagnostic/span"
import "ka:parse/token"

is file -> str -> [token, nat], [diagnostic]
lex file input =
  let state = {
    file:      file
    offset:    0
    remaining: input
  }

  let state, ts, ds = token state [] []

  ts, ds

is state -> state, token
local token state =
  symbol state
    |> some-or (invalid state)

local type state = {
  file:      file
  offset:    nat
  remaining: str
}

local symbol state =
  symbols
    |> list.find \s, _. starts-with s state.remaining
    |> map-some \s, t.
      let n = length s
      advance n state, t

local invalid state =
  let s, _ = split-at 1 state.remaining
  advance 1 state, :invalid s

local advance n state =
  let _, remaining = split-at n state.remaining

  state with {
    offset:    state.offset + n
    remaining: remaining
  }

is [str, token]
local symbols = [
  "::", :colon-colon
]
