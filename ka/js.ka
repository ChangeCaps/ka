import "std:fs"     as fs
import "std:set"    as set
import "std:list"   as list
import "std:hash"   as hash
import "std:string" as string
import "std:assert" as assert
import "std:result" as result

import "ka:ir"

js program main = do
  let global = program
    |> fold set.empty \global var, expr.
      match expr
        :lam _ -> global
        _ -> set.insert var.id global

  let state = {
    global: global
  }

  let defines = program
    |> map \var, _.
      js-var var
        |> string.prepend "let "
        |> string.append ";"
    |> join ""

  let program = program
    |> fold "" \program var, expr.
      let body = match expr
        :lam _ ->
          let _, expr = js-expr state "" expr
          expr

        _ ->
          let body, expr = js-expr state "" expr

          "() => {"
            |> string.append body
            |> string.append "return "
            |> string.append expr
            |> string.append ";}"

      program
        |> string.append "\n// "
        |> string.append var.name
        |> string.append "\n"
        |> string.append (js-var var)
        |> string.append " = "
        |> string.append body
        |> string.append "\n"

  let prelude <- fs.read "prelude.js"

  let program, main = js-expr state program main

  do "#!/usr/bin/env node\n"
    |> string.append (assert-ok prelude)
    |> string.append defines
    |> string.append "\n"
    |> string.append program
    |> string.append main
    |> string.append "()"

local type state = {
  global: set nat
}

is state -> str -> expr -> str, str
local js-expr state body expr =
  match expr
    :var var ->
      match set.has var.id state.global
        :true ->
          let expr = js-var var
            |> string.append "()"

          body, expr
        :false -> body, js-var var

    :lit lit ->
      let lit = match lit
        :str' s -> js-str s
        :nat' x -> string.format x
        :int' x -> string.format x
        :real' x -> string.format x

      body, lit

    :lam (var, expr) ->
      let expr =
        let body, expr = js-expr state "" expr

        "("
          |> string.append (js-var var)
          |> string.append ") => {"
          |> string.append body
          |> string.append " return "
          |> string.append expr
          |> string.append ";"
          |> string.append "}"

      body, expr

    :app (lambda, input) ->
      let body, lambda = js-expr state body lambda
      let body, input = js-expr state body input

      let expr = lambda
        |> string.prepend "("
        |> string.append ")("
        |> string.append input
        |> string.append ")"

      body, expr

    :rec (_, _) -> panic ""

    :bind (input, var, output) ->
      let body, input = js-expr state body input

      let body = body
        |> string.append " let "
        |> string.append (js-var var)
        |> string.append " = "
        |> string.append input
        |> string.append ";"

      js-expr state body output

    :field (expr, field) ->
      let body, expr = js-expr state body expr

      let field = match field
        :name s -> s
          |> string.prepend "[\""
          |> string.append "\"]"

        :index n -> n
          |> string.format
          |> string.prepend "["
          |> string.append "]"

      let expr = expr
        |> string.prepend "("
        |> string.append ")"
        |> string.append field

      body, expr

    :case (scrutinee, arms) ->
      let body, scrutinee = js-expr state body scrutinee

      let result = "r"
        |> string.append (string.format (hash scrutinee))

      let switched = match list.first arms
        :some (:variant _, _) -> "true"
        :some (:cons _, _) -> string.prepend scrutinee ".head != null"
        :some (:empty, _) -> string.prepend scrutinee ".head != null"
        _ -> scrutinee

      let body = body
        |> string.append " let "
        |> string.append result
        |> string.append "; switch ("
        |> string.append switched
        |> string.append ") {"

      let body = arms
        |> fold body \body alt, expr.
          let inner, case = match alt
            :str' s ->
              let case = "case "
                |> string.append (js-str s)
                |> string.append ":"

              "", case

            :variant ("true", :none) ->
              let case = "case "
                |> string.append scrutinee
                |> string.append ":"

              "", case

            :variant ("false", :none) ->
              let case = "case !("
                |> string.append scrutinee
                |> string.append "):"

              "", case

            :variant (name, payload) ->
              let inner = match payload
                :some payload ->
                  " let "
                    |> string.append (js-var payload)
                    |> string.append " = "
                    |> string.append scrutinee
                    |> string.append ".payload;"
                :none -> ""

              let case = "case "
                |> string.append scrutinee
                |> string.append ".name == \""
                |> string.append name
                |> string.append "\":"

              inner, case

            :cons (head, tail) ->
              let inner = " let "
                |> string.append (js-var head)
                |> string.append " = "
                |> string.append scrutinee
                |> string.append ".head;"
                |> string.append " let "
                |> string.append (js-var tail)
                |> string.append " = "
                |> string.append scrutinee
                |> string.append ".tail;"

              inner, "case true:"

            :empty -> "", "case false:"

            :default -> "", "default:"

          let inner, expr = js-expr state inner expr

          body
            |> string.append case
            |> string.append "{"
            |> string.append inner
            |> string.append " "
            |> string.append result
            |> string.append " = "
            |> string.append expr
            |> string.append "; break; }"
        |> string.append "}"

      body, result

    :cons cons ->
      match cons
        :variant ("true", :none) -> body, "true"
        :variant ("false", :none) -> body, "false"

        :variant (name, payload) ->
          let body, payload = match payload
            :some payload -> js-expr state body payload
            :none -> body, "null"

          let expr = "new Variant(\""
            |> string.append name
            |> string.append "\", "
            |> string.append payload
            |> string.append ")"

          body, expr

        :empty -> body, "List.empty"

        :cons (head, tail) ->
          let body, head = js-expr state body head
          let body, tail = js-expr state body tail

          let expr = "new List("
            |> string.append head
            |> string.append ", "
            |> string.append tail
            |> string.append ")"

          body, expr

        :tuple fields ->
          let body, fields = fields
            |> fold (body, []) \body, fields field.
              let body, field = js-expr state body field
              body, list.append [field] fields

          let expr = "["
            |> string.append (string.join ", " fields)
            |> string.append "]"

          body, expr

        :record (from, fields) ->
          let body, fields = fields
            |> fold (body, []) \body, fields name, expr.
              let body, expr = js-expr state body expr

              let field = "\""
                |> string.append name
                |> string.append "\": "
                |> string.append expr

              body, list.append [field] fields

          let expr = "{ "
            |> string.append (string.join ", " fields)
            |> string.append " }"

          match from
            :some from ->
              let body, from = js-expr state body from

              let expr = "withFields("
                |> string.append from
                |> string.append ", "
                |> string.append expr
                |> string.append ")"

              body, expr

            :none -> body, expr

        _ -> panic (string.format cons)

    :prim prim ->
      match prim
        :extern' extern' ->
          let expr = "extern[\""
            |> string.append extern'.id
            |> string.append "\"]"

          body, expr

        :unary (op, expr) ->
          let body, expr = js-expr state body expr

          let call f =
            let expr = f
              |> string.append "("
              |> string.append expr
              |> string.append ")"

            body, expr

          match op
            :dynamic -> call "dynamic"
            :panic -> call "panic"

            :num-to-str _ -> call "String"
            :num-hash _ -> call "numberHash"
            :num-cast _ -> body, expr

            :str-hash -> call "stringHash"
            :str-length -> call "stringLength"

            :io-pure -> call "pure"

        :binary (op, lhs, rhs) ->
          let body, lhs = js-expr state body lhs
          let body, rhs = js-expr state body rhs

          let call f =
            let expr = f
              |> string.append "("
              |> string.append lhs
              |> string.append ", "
              |> string.append rhs
              |> string.append ")"

            body, expr

          let binary op =
            let expr = "("
              |> string.append lhs
              |> string.append " "
              |> string.append op
              |> string.append " "
              |> string.append rhs
              |> string.append ")"

            body, expr

          match op
            :add _ -> binary "+"
            :sub _ -> binary "-"
            :mul _ -> binary "*"
            :div _ -> binary "/"
            :gt _ -> binary ">"
            :lt _ -> binary "<"
            :ge _ -> binary ">="
            :le _ -> binary "<="
            :land -> binary "&&"
            :lor -> binary "||"

            :eq -> call "isDeepStrictEqual"
            :ne -> call "!isDeepStrictEqual"

            :trace -> call "trace"

            :nat-xor -> binary "^"

            :str-prepend -> binary "+"
            :str-split-at -> call "stringSplit"
            :str-find -> call "stringFind"

            :io-bind -> call "bind"

local js-str s =
  s |> string.replace "\\" "\\\\"
    |> string.replace "\"" "\\\""
    |> string.replace "\n" "\\n"
    |> string.replace "\r" "\\r"
    |> string.replace "\t" "\\t"
    |> string.replace "\0" "\\0"
    |> string.prepend "\""
    |> string.append "\""

local js-var var =
  string.format var.id
    |> string.prepend "v"
