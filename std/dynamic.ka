import "std:list"
import "std:option"

import "intrinsic" as intrinsic

type dynamic =
  | :lambda
  | :action
  | :nat' nat
  | :int' int
  | :real' real
  | :str' str
  | :tuple list dynamic
  | :record list (str, dynamic)
  | :variant (str, option dynamic)

is 'a -> dynamic
dynamic x = intrinsic::dynamic x
