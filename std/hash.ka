import "std:list"
import "std:dynamic"

import "intrinsic" as intrinsic

is nat -> nat -> nat
xor x y = intrinsic.nat-xor (x, y)

is 'a -> nat
hash x = hash-dynamic (dynamic x)

local hash-dynamic x =
  match x
    :lambda -> hash 0
    :action -> hash 1

    :str' x -> intrinsic.hash-str x
    :nat' x -> intrinsic.hash-nat x
    :int' x -> intrinsic.hash-int x
    :real' x -> intrinsic.hash-real x

    :list xs -> xs
      |> map hash-dynamic
      |> fold 0 xor

    :tuple xs -> xs
      |> map hash-dynamic
      |> fold 0 xor

    :record xs -> xs
      |> map \_, x. hash-dynamic x
      |> fold 0 xor

    :variant (n, x) -> match x
      :none -> hash n
      :some x -> xor (hash n) (hash-dynamic x)
