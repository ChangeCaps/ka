import "std:option"

type list 'a = option ('a, list 'a)

is list 'a
empty = :none

is 'a -> list 'a -> list 'a
push x xs = :some (x, xs)

is ('a -> 'b) -> list 'a -> list 'b
map f xs =
  match xs
    :none -> empty
    :some (x, xs) ->
      let x = f x
      let xs = map f xs
      push x xs

is ('a -> bool) -> list 'a -> list 'a
filter f xs =
  match xs
    :none -> empty
    :some (x, xs) ->
      let xs = filter f xs
      match f x
        :false -> xs
        :true -> push x xs

is 'acc -> ('acc -> 'a -> 'acc) -> list 'a -> 'acc
fold acc f xs =
  match xs
    :none -> acc
    :some (x, xs) ->
      let acc = f acc x
      fold acc f xs

is ('a -> 'a -> 'a) -> list 'a -> option 'a
reduce f xs =
  xs |> fold (:none) \acc x.
    match acc
      :none -> :some x
      :some x' -> :some f x x'

is list 'a -> nat
count xs = xs |> fold 0 \c _. c + 1

is nat -> list 'a -> list 'a
skip n xs =
  match xs
    :none -> :none
    :some (x, xs') ->
      match n > 0
        :false -> xs
        :true -> skip (n - 1) xs'

is nat -> list 'a -> option 'a
nth n xs =
  match skip n xs
   :some (x, _) -> :some x
   :none -> :none
