import "std:option"

is 'a -> ['a] -> ['a]
push x xs = x :: xs

is ['a] -> option ('a, ['a])
pop xs = match xs
  x :: xs -> :some (x, xs)
  [] -> :none

is ['a] -> option 'a
first xs = match xs
  x :: _ -> :some x
  [] -> :none 

is ('a -> 'b) -> ['a] -> ['b]
map f xs = match xs
  x :: xs -> f x :: map f xs
  [] -> []

is ('a -> bool) -> ['a] -> ['a]
filter f xs = match xs
  x :: xs -> match f x
    :false -> filter f xs
    :true -> x :: filter f xs
  [] -> []

is [option 'a] -> ['a]
filter-some xs = match xs
  x :: xs -> match x
    :some x -> x :: filter-some xs
    :none -> filter-some xs
  [] -> []

is ('a -> option 'b) -> ['a] -> ['b]
filter-map f xs = xs |> map f |> filter-some

is [['a]] -> ['a]
flatten xss = match xss
  xs :: xss -> append (flatten xss) xs
  [] -> []

is ['a] -> ['a]
reverse xs = extend-reversed xs []

is ['a] -> ['a] -> ['a]
append ys xs = match xs
  x :: xs -> x :: append ys xs
  [] -> ys

is ('a -> bool) -> ['a] -> option 'a
find f xs = match xs
  x :: xs -> match f x
    :true -> :some x
    :false -> find f xs
  [] -> :none

is ('a -> bool) -> ['a] -> bool
any f xs = find f xs |> is-some

is 'a -> ['a] -> bool
contains x xs = xs |> any \x'. x' == x

is 'acc -> ('acc -> 'a -> 'acc) -> ['a] -> 'acc
fold acc f xs = match xs
  x :: xs -> fold (f acc x) f xs
  [] -> acc

is ('a -> !'b) -> ['a] -> !['b]
each f xs = match xs
  x :: xs -> do
    let x <- f x
    let xs <- each f xs
    do x :: xs
  [] -> do []

is ('a -> 'a -> 'a) -> ['a] -> option 'a
reduce f xs =
  xs |> fold (:none) \acc x.
    match acc
      :none -> :some x
      :some x' -> :some f x x'

is ['a] -> nat
count xs = xs |> fold 0 \c _. c + 1

is nat -> ['a] -> ['a]
skip n xs = match xs
  x :: xs' -> match n > 0
    :false -> xs
    :true -> skip (n - 1) xs'
  [] -> []

is nat -> ['a] -> option 'a
nth n xs = skip n xs |> first

is ['a] -> ['a] -> ['a]
local extend-reversed ys xs = match ys
  y :: ys -> extend-reversed ys (y :: xs)
  [] -> xs
