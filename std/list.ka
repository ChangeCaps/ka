import "std:option"

type list 'a = option ('a, list 'a)

is list 'a
empty = :none

is 'a -> list 'a -> list 'a
push x xs = :some (x, xs)

is 'a -> list 'a
one x = empty |> push x

is ('a -> 'b) -> list 'a -> list 'b
map f xs =
  match xs
    :none -> empty
    :some (x, xs) ->
      let x = f x
      let xs = map f xs
      push x xs

is ('a -> bool) -> list 'a -> list 'a
filter f xs =
  match xs
    :none -> empty
    :some (x, xs) ->
      let xs = filter f xs
      match f x
        :false -> xs
        :true -> push x xs

is ('a -> option 'b) -> list 'a -> list 'b
filter-map f xs =
  match xs
    :none -> empty
    :some (x, xs) ->
      let xs = filter-map f xs
      match f x
        :none -> xs
        :some x -> push x xs

is list 'a -> list 'a
reverse xs = extend-reversed xs empty

is list 'a -> list 'a -> list 'a
append ys xs =
  match xs
    :none -> xs
    :some (x, xs) ->
      append ys xs
        |> push x

is 'acc -> ('acc -> 'a -> 'acc) -> list 'a -> 'acc
fold acc f xs =
  match xs
    :none -> acc
    :some (x, xs) ->
      let acc = f acc x
      fold acc f xs

is ('a -> !'b) -> list 'a -> !list 'b
each f xs =
  match xs
    :none -> do :none
    :some (x, xs) -> do
      let x <- f x
      let xs <- each f xs
      do push x xs

is ('a -> 'a -> 'a) -> list 'a -> option 'a
reduce f xs =
  xs |> fold (:none) \acc x.
    match acc
      :none -> :some x
      :some x' -> :some f x x'

is list 'a -> nat
count xs = xs |> fold 0 \c _. c + 1

is nat -> list 'a -> list 'a
skip n xs =
  match xs
    :none -> :none
    :some (x, xs') ->
      match n > 0
        :false -> xs
        :true -> skip (n - 1) xs'

is nat -> list 'a -> option 'a
nth n xs =
  match skip n xs
   :some (x, _) -> :some x
   :none -> :none

local extend-reversed ys xs =
  match ys
    :none -> xs
    :some (y, ys) ->
      let xs = push y xs
      extend-reversed ys xs
