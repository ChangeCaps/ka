type option 'a =
  | :some 'a
  | :none

is ('a -> 'b) -> option 'a -> option 'b
let map-some f x =
  match x
    :some x -> :some f x
    :none -> :none

is ('a -> option 'b) -> option 'a -> option 'b
let and-then f x =
  match x
    :some x -> f x
    :none -> :none

is 'a -> option 'a -> 'a
let some-or otherwise x =
  match x
    :some x -> x
    _ -> otherwise

is option 'a -> bool
let is-some x =
  match x
    :some _ -> :true
    _ -> :false

is option 'a -> bool
let is-none x =
  match x
    :some _ -> :false
    _ -> :true

is ('a -> bool) -> option 'a -> option 'a
let some-if f x =
  match x
    :none -> :none
    :some x ->
      match f x
        :true -> :some x
        :false -> :none

is ('a -> bool) -> option 'a -> bool
let is-some-and f x =
  match x
    :some x -> f x
    :none -> :false
