import "std:string"  as string
import "std:result"  as result
import "std:dynamic" as dynamic

type error =
  | :not-found

type result 'a = result.result 'a error

extern "io::readln" readln is !str

is 'a -> !{}
print x =
  extern "io::print" print is str -> !{}

  match dynamic x
    :str' s -> print s
    _       -> print (format x)

is 'a -> !{}
println x = do
  print x
  print "\n"
