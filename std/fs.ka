import "std:io"     as io
import "std:os"     as os
import "std:result" as result
import "std:string" as string
import "std:list"   as list

extern "fs::read" read is str -> !io.result str
extern "fs::write" write is str -> str -> !io.result {}

extern "fs::is-dir" is-dir is str -> !bool
extern "fs::read-dir" read-dir is str -> !io.result [str]

is str -> !bool
is-file path = do
  let result <- os.execute ["test"; "-f"; path]

  do result
    |> map-ok \code, _. code == 0
    |> ok-or :false
