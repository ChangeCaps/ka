import "std:list" as list
import "std:option" as option
import "std:dynamic"

import "intrinsic" as intrinsic

is str -> nat
length x = intrinsic::str-length x

is str -> bool
is-empty x = length x == 0

is 'a -> str
format x = format-dynamic 0 (dynamic x)

is str -> str -> str
prepend a b = intrinsic::str-prepend (a, b)

is nat -> str -> str, str
split-at n s = intrinsic::str-split-at (s, n)

is str -> option (str, str)
pop s = match is-empty s
  :true -> :none
  :false -> :some split-at 1 s

is str -> option str
first s = s |> pop |> map-some \x, _. x

is str -> list str
graphemes s =
  match pop s
    :none -> list::empty
    :some (c, rest) -> list::push c (graphemes rest)

is str -> str -> option nat
find needle haystack = intrinsic::str-find (haystack, needle)

is str -> str -> bool
contains needle haystack = find needle haystack |> option::is-some

is str -> str -> str
append a b = prepend b a

is str -> str -> str
trim prefix s =
  let start, rest = split-at (length prefix) s

  match start == prefix
    :false -> s
    :true -> rest

is str -> str -> list str
split needle haystack =
  find needle haystack
    |> map-some \n. split-at n haystack
    |> map-some \first, rest.
      trim needle rest
        |> split needle
        |> push first
    |> some-or (empty |> push haystack)

is str -> list str -> str
join sep xs =
  match xs
    :none -> ""
    :some (x, xs) ->
      match xs
        :none -> x
        :some _ -> x
          |> append sep
          |> append (join sep xs)

local format-dynamic p x =
  let paren p p' s =
    match p > p'
      :true -> s |> prepend "(" |> append ")"
      :false -> s

  match x
    :str' s -> s
    :nat' x -> intrinsic::format-nat x
    :int' x -> intrinsic::format-int x
    :real' x -> intrinsic::format-real x

    :lambda -> "lambda"
    :action -> "action"

    :record xs ->
      match xs
        :none -> "{}"
        :some _ -> xs
          |> list::map \n, x. n
            |> append ": "
            |> append (format-dynamic 0 x)
          |> join "; "
          |> prepend "{ "
          |> append " }"

    :tuple xs -> xs
      |> list::map (format-dynamic 1)
      |> join ", "
      |> paren p 0

    :variant (name, x) ->
      name
        |> prepend ":"
        |> append " "
        |> append (format-dynamic 1 x)
        |> paren p 1
