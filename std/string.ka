import "std:list"
import "std:option"

import "intrinsic" as intrinsic

is str -> nat
length x = intrinsic::string-length x

is 'a -> str
format x = intrinsic::string-format x

is str -> str -> str
prepend a b = intrinsic::string-prepend (a, b)

is nat -> str -> option (str, str)
split-at n s = intrinsic::string-split-at (s, n)

is str -> str -> option nat
find needle haystack = intrinsic::string-find (haystack, needle)

is str -> str -> str
append a b = prepend b a

is str -> str -> str
trim prefix s =
  match split-at (length prefix) s
    :none -> s
    :some (start, rest) ->
      match start == prefix
        :false -> s
        :true -> rest

is str -> str -> list str
split needle haystack =
  find needle haystack
    |> and-then \n. split-at n haystack
    |> map-some \first, rest.
      trim needle rest
        |> split needle
        |> push first
    |> some-or (empty |> push haystack)
