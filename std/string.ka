import "std:list" as list
import "std:option" as option
import "std:dynamic"

import "intrinsic" as intrinsic

extern "string::ansi-escape" ansi-escape is str

is str -> nat
length x = intrinsic.str-length x

is str -> bool
is-empty x = x == ""

is 'a -> str
format x = format-dynamic 0 (dynamic x)

is 'a -> str
format-pretty x = format-dynamic-pretty 1 0 (dynamic x)

is str -> str -> str
prepend a b = intrinsic.str-prepend (a, b)

is nat -> str -> str, str
split-at n s = intrinsic.str-split-at (s, n)

is nat -> nat -> str -> str
sub start length s =
  let _, rest   = split-at start s
  let output, _ = split-at length rest

  output

is str -> option (str, str)
pop s = match is-empty s
  :true -> :none
  :false -> :some split-at 1 s

is str -> option str
first s = s |> pop |> map-some \x, _. x

is str -> [str]
graphemes s = match pop s
  :some (c, rest) -> c :: graphemes rest
  :none -> []

is str -> str -> option nat
find needle haystack = intrinsic.str-find (haystack, needle)

is str -> str -> bool
contains needle haystack = find needle haystack |> option.is-some

is str -> str -> str
append a b = prepend b a

is str -> str -> bool
starts-with prefix s = trim prefix s != s

is nat -> str -> str
repeat n s =
  match n > 0
    :true -> repeat (n - 1) s |> append s
    :false -> ""

is str -> str -> str -> str
replace a b s = match find a s
  :none -> s
  :some n ->
    let start, rest = split-at n s

    rest
      |> trim a
      |> replace a b
      |> prepend b
      |> prepend start

is str -> str -> str
trim prefix s =
  let start, rest = split-at (length prefix) s

  match start == prefix
    :false -> s
    :true -> rest

is str -> str -> [str]
split needle haystack =
  find needle haystack
    |> map-some \n. split-at n haystack
    |> map-some \first, rest.
      trim needle rest
        |> split needle
        |> push first
    |> some-or [haystack]

is str -> [str] -> str
join sep xs = match xs
  x :: [] -> x
  x :: xs -> x
    |> append sep
    |> append (join sep xs)
  [] -> ""

local format-dynamic p x =
  let paren p p' s =
    match p > p'
      :true -> s |> prepend "(" |> append ")"
      :false -> s

  match x
    :str' s ->
      s
        |> replace "\\" "\\\\"
        |> replace "\"" "\\\""
        |> replace "\n" "\\n"
        |> replace "\r" "\\r"
        |> replace "\t" "\\t"
        |> replace "\0" "\\0"
        |> prepend "\""
        |> append "\""

    :nat' x -> intrinsic.format-nat x
    :int' x -> intrinsic.format-int x
    :real' x -> intrinsic.format-real x

    :lambda -> "lambda"
    :action -> "action"

    :list xs -> xs
      |> list.map (format-dynamic 0)
      |> join "; "
      |> prepend "["
      |> append "]"

    :tuple xs -> xs
      |> list.map (format-dynamic 1)
      |> join ", "
      |> paren p 0

    :record xs -> match xs
      [] -> "{}"
      _  -> xs
        |> list.map \n, x. n
          |> append ": "
          |> append (format-dynamic 0 x)
        |> join "; "
        |> prepend "{ "
        |> append " }"

    :variant (name, x) -> match x
      :none -> name |> prepend ":"
      :some x -> name
        |> prepend ":"
        |> append " "
        |> append (format-dynamic 1 x)
        |> paren p 1

local format-dynamic-pretty l p x =
  let paren p p' s =
    match p > p'
      :true -> s |> prepend "(" |> append ")"
      :false -> s

  let line n = "  "
    |> repeat n
    |> prepend "\n"

  match x
    :str' s ->
      s
        |> replace "\\" "\\\\"
        |> replace "\"" "\\\""
        |> replace "\n" "\\n"
        |> replace "\r" "\\r"
        |> replace "\t" "\\t"
        |> replace "\0" "\\0"
        |> prepend "\""
        |> append "\""

    :nat' x -> intrinsic.format-nat x
    :int' x -> intrinsic.format-int x
    :real' x -> intrinsic.format-real x

    :lambda -> "lambda"
    :action -> "action"

    :list xs -> xs
      |> list.map (format-dynamic-pretty (l + 1) 0)
      |> join (line l)
      |> prepend (line l)
      |> prepend "["
      |> append (line (l - 1))
      |> append "]"

    :tuple xs -> xs
      |> list.map (format-dynamic-pretty l 1)
      |> join ", "
      |> paren p 0

    :record xs -> match xs
      [] -> "{}"
      _  -> xs
        |> list.map \n, x. n
          |> append ": "
          |> append (format-dynamic-pretty (l + 1) 0 x)
        |> join (line l)
        |> prepend (line l)
        |> prepend "{"
        |> append (line (l - 1))
        |> append "}"

    :variant (name, x) -> match x
      :none -> name |> prepend ":"
      :some x -> name
        |> prepend ":"
        |> append " "
        |> append (format-dynamic-pretty l 1 x)
        |> paren p 1
